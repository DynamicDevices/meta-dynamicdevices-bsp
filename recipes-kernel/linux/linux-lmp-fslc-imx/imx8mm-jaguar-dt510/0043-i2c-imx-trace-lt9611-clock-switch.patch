From: Briar <briar@dynamicdevices.co.uk>
Subject: [PATCH] i2c: imx: capture DT510 clock-switch phases before userspace

Temporary diagnostic, not a startup fix. Bound memory capture to adapter2,
address0x39, one two-byte write matching01/18; that pattern alone does not
prove the current register page. Record wait/IRQ/controller state and emit
summaries after the transfer. Preserve register writes, return values,
timeout/retry policy and boot settings. Added timestamp/status reads and
post-transfer output can perturb a timing-sensitive failure.

IRQ samples and final copy use the existing slave_lock. Capture at most
three waits and four IRQ records, reporting total counts if truncated.
Keep the existing reset/recovery candidate unchanged. Remove diagnostics
when the startup defect is understood and the fix is qualified.

Upstream-Status: Inappropriate [DT510 development diagnostics]
Assisted-by: Briar

--- a/drivers/i2c/busses/i2c-imx.c
+++ b/drivers/i2c/busses/i2c-imx.c
@@ -37,6 +37,7 @@
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
+#include <linux/ktime.h>
 #include <linux/spinlock.h>
 #include <linux/hrtimer.h>
 #include <linux/module.h>
@@ -254,6 +255,24 @@
 	enum dma_data_direction dma_data_dir;
 };
 
+/* Temporary DT510 diagnostics. Samples are bounded; never log in the ISR. */
+struct imx_i2c_dt510_diag {
+	bool active;
+	u64 pm_ns, idle_ns, start_ns, stop_ns;
+	int pm_ret, idle_ret, start_ret, stop_ret;
+	unsigned int waits, irqs;
+	struct {
+		u64 ns;
+		unsigned long sr;
+		unsigned int irqs;
+	} wait[3];
+	struct {
+		u64 ns;
+		unsigned int sr, cr;
+	} irq[4];
+	unsigned int stop_sr, stop_cr;
+};
+
 struct imx_i2c_struct {
 	struct i2c_adapter	adapter;
 	struct clk		*clk;
@@ -264,6 +283,7 @@
 	unsigned int		disable_delay;
 	int			stopped;
 	int			stop_result;
+	struct imx_i2c_dt510_diag dt510_diag;
 	unsigned int		ifdr; /* IMX_I2C_IFDR */
 	unsigned int		cur_clk;
 	unsigned int		bitrate;
@@ -610,6 +630,8 @@
 
 static int i2c_imx_trx_complete(struct imx_i2c_struct *i2c_imx, bool atomic)
 {
+	u64 diag_start = READ_ONCE(i2c_imx->dt510_diag.active) ? ktime_get_ns() : 0;
+
 	if (atomic) {
 		void __iomem *addr = i2c_imx->base + (IMX_I2C_I2SR << i2c_imx->hwdata->regshift);
 		unsigned int regval;
@@ -631,6 +653,20 @@
 		wait_event_timeout(i2c_imx->queue, i2c_imx->i2csr & I2SR_IIF, HZ / 10);
 	}
 
+	if (diag_start) {
+		struct imx_i2c_dt510_diag *d = &i2c_imx->dt510_diag;
+		unsigned long flags;
+		unsigned int n = d->waits++;
+
+		if (n < ARRAY_SIZE(d->wait)) {
+			d->wait[n].ns = ktime_get_ns() - diag_start;
+			d->wait[n].sr = i2c_imx->i2csr;
+			spin_lock_irqsave(&i2c_imx->slave_lock, flags);
+			d->wait[n].irqs = d->irqs;
+			spin_unlock_irqrestore(&i2c_imx->slave_lock, flags);
+		}
+	}
+
 	if (unlikely(!(i2c_imx->i2csr & I2SR_IIF))) {
 		dev_dbg(&i2c_imx->adapter.dev, "<%s> Timeout\n", __func__);
 		return -ETIMEDOUT;
@@ -1034,6 +1070,17 @@
 	status = imx_i2c_read_reg(i2c_imx, IMX_I2C_I2SR);
 	ctl = imx_i2c_read_reg(i2c_imx, IMX_I2C_I2CR);
 
+	if (i2c_imx->dt510_diag.active) {
+		struct imx_i2c_dt510_diag *d = &i2c_imx->dt510_diag;
+		unsigned int n = d->irqs++;
+
+		if (n < ARRAY_SIZE(d->irq)) {
+			d->irq[n].ns = ktime_get_ns();
+			d->irq[n].sr = status;
+			d->irq[n].cr = ctl;
+		}
+	}
+
 	if (status & I2SR_IIF) {
 		i2c_imx_clear_irq(i2c_imx, I2SR_IIF);
 		if (i2c_imx->slave) {
@@ -1382,9 +1429,15 @@
 	int result, stop_ret;
 	bool is_lastmsg = false;
 	struct imx_i2c_struct *i2c_imx = i2c_get_adapdata(adapter);
+	struct imx_i2c_dt510_diag *diag = &i2c_imx->dt510_diag;
+	u64 diag_start = READ_ONCE(diag->active) ? ktime_get_ns() : 0;
 
 	/* Start I2C transfer */
 	result = i2c_imx_start(i2c_imx, atomic);
+	if (diag_start) {
+		diag->start_ns = ktime_get_ns() - diag_start;
+		diag->start_ret = result;
+	}
 	if (result) {
 		/*
 		 * Bus recovery uses gpiod_get_value_cansleep() which is not
@@ -1450,7 +1503,15 @@
 
 fail0:
 	/* Stop I2C transfer */
+	diag_start = READ_ONCE(diag->active) ? ktime_get_ns() : 0;
 	stop_ret = i2c_imx_stop(i2c_imx, atomic);
+	if (diag_start) {
+		diag->stop_ns = ktime_get_ns() - diag_start;
+		diag->stop_ret = stop_ret;
+		/* Read-only status snapshots after STOP/controller-disable. */
+		diag->stop_sr = imx_i2c_read_reg(i2c_imx, IMX_I2C_I2SR);
+		diag->stop_cr = imx_i2c_read_reg(i2c_imx, IMX_I2C_I2CR);
+	}
 	if (stop_ret) {
 		/* The byte may have been ACKed, but the transfer did not finish. */
 		if (result >= 0)
@@ -1548,19 +1609,25 @@
 	return 0;
 }
 
-static int i2c_imx_xfer(struct i2c_adapter *adapter,
+static int i2c_imx_xfer_raw(struct i2c_adapter *adapter,
 			struct i2c_msg *msgs, int num)
 {
 	struct imx_i2c_struct *i2c_imx = i2c_get_adapdata(adapter);
 	bool enable_runtime_pm = false;
 	int result;
+	u64 diag_start;
 
 	if (!pm_runtime_enabled(i2c_imx->adapter.dev.parent)) {
 		pm_runtime_enable(i2c_imx->adapter.dev.parent);
 		enable_runtime_pm = true;
 	}
 
+	diag_start = READ_ONCE(i2c_imx->dt510_diag.active) ? ktime_get_ns() : 0;
 	result = pm_runtime_resume_and_get(i2c_imx->adapter.dev.parent);
+	if (diag_start) {
+		i2c_imx->dt510_diag.pm_ns = ktime_get_ns() - diag_start;
+		i2c_imx->dt510_diag.pm_ret = result;
+	}
 	if (result < 0) {
 		if (enable_runtime_pm)
 			pm_runtime_disable(i2c_imx->adapter.dev.parent);
@@ -1571,7 +1638,12 @@
 	 * workaround for ERR010027: ensure that the I2C BUS is idle
 	 * before switching to master mode and attempting a Start cycle
 	 */
+	diag_start = READ_ONCE(i2c_imx->dt510_diag.active) ? ktime_get_ns() : 0;
 	result =  i2c_imx_bus_busy(i2c_imx, 0, false);
+	if (diag_start) {
+		i2c_imx->dt510_diag.idle_ns = ktime_get_ns() - diag_start;
+		i2c_imx->dt510_diag.idle_ret = result;
+	}
 	if (result) {
 		/* timeout */
 		if ((result == -ETIMEDOUT) && (i2c_imx->layerscape_bus_recover == 1))
@@ -1594,6 +1666,62 @@
 	return result;
 }
 
+static bool i2c_imx_dt510_clock_msg(struct i2c_adapter *adapter,
+				    struct i2c_msg *msgs, int num)
+{
+	return adapter->nr == 2 && num == 1 && msgs[0].addr == 0x39 &&
+		!(msgs[0].flags & (I2C_M_RD | I2C_M_TEN | I2C_M_RECV_LEN)) &&
+		msgs[0].len == 2 && msgs[0].buf &&
+		msgs[0].buf[0] == 0x01 && msgs[0].buf[1] == 0x18;
+}
+
+static int i2c_imx_xfer(struct i2c_adapter *adapter,
+		      struct i2c_msg *msgs, int num)
+{
+	struct imx_i2c_struct *i2c_imx = i2c_get_adapdata(adapter);
+	struct imx_i2c_dt510_diag sample;
+	unsigned long flags;
+	u64 start, elapsed;
+	unsigned int n;
+	int result;
+
+	if (!i2c_imx_dt510_clock_msg(adapter, msgs, num))
+		return i2c_imx_xfer_raw(adapter, msgs, num);
+
+	/* Adapter lock serializes transfers; slave_lock also covers the ISR. */
+	spin_lock_irqsave(&i2c_imx->slave_lock, flags);
+	memset(&i2c_imx->dt510_diag, 0, sizeof(i2c_imx->dt510_diag));
+	i2c_imx->dt510_diag.active = true;
+	spin_unlock_irqrestore(&i2c_imx->slave_lock, flags);
+	start = ktime_get_ns();
+	result = i2c_imx_xfer_raw(adapter, msgs, num);
+	elapsed = ktime_get_ns() - start;
+	spin_lock_irqsave(&i2c_imx->slave_lock, flags);
+	i2c_imx->dt510_diag.active = false;
+	sample = i2c_imx->dt510_diag;
+	spin_unlock_irqrestore(&i2c_imx->slave_lock, flags);
+
+	/* No printing in added wait/IRQ hooks. Pattern match is not page proof. */
+	dev_info(&adapter->dev,
+		 "DT510-PHASE bytes=01-18 ret=%d total_ns=%llu clk=%u ifdr=%02x waits=%u irqs=%u\n",
+		 result, elapsed, i2c_imx->cur_clk, i2c_imx->ifdr,
+		 sample.waits, sample.irqs);
+	dev_info(&adapter->dev,
+		 "DT510-PHASE pm=%d/%llu idle=%d/%llu start=%d/%llu stop=%d/%llu stop_sr=%02x stop_cr=%02x units=ns\n",
+		 sample.pm_ret, sample.pm_ns, sample.idle_ret, sample.idle_ns,
+		 sample.start_ret, sample.start_ns, sample.stop_ret, sample.stop_ns,
+		 sample.stop_sr, sample.stop_cr);
+	for (n = 0; n < min_t(unsigned int, sample.waits, ARRAY_SIZE(sample.wait)); n++)
+		dev_info(&adapter->dev,
+			 "DT510-PHASE wait=%u ns=%llu cached_sr=%02lx irqs=%u\n",
+			 n, sample.wait[n].ns, sample.wait[n].sr, sample.wait[n].irqs);
+	for (n = 0; n < min_t(unsigned int, sample.irqs, ARRAY_SIZE(sample.irq)); n++)
+		dev_info(&adapter->dev,
+			 "DT510-PHASE irq=%u at_ns=%llu sr=%02x cr=%02x\n",
+			 n, sample.irq[n].ns, sample.irq[n].sr, sample.irq[n].cr);
+	return result;
+}
+
 static int i2c_imx_xfer_atomic(struct i2c_adapter *adapter,
 			       struct i2c_msg *msgs, int num)
 {

