 	if (result)
 		return result;
@@ -763,10 +766,10 @@
 	return result;
 }
 
-static void i2c_imx_stop(struct imx_i2c_struct *i2c_imx, bool atomic)
+static int i2c_imx_stop(struct imx_i2c_struct *i2c_imx, bool atomic)
 {
 	unsigned int temp = 0;
-	int ret;
+	int ret = i2c_imx->stop_result;
 
 	if (!i2c_imx->stopped) {
 		/* Stop I2C transaction */
@@ -786,17 +789,18 @@
 		udelay(i2c_imx->disable_delay);
 	}
 
-	if (!i2c_imx->stopped) {
+	if (!i2c_imx->stopped && !ret) {
 		ret = i2c_imx_bus_busy(i2c_imx, 0, atomic);
 		if (ret && i2c_imx->adapter.nr == 2)
 			dev_err(&i2c_imx->adapter.dev,
-				"DT510-DIAG STOP wait ret=%d (legacy result still ignored)\n",
+				"DT510-DIAG STOP wait ret=%d\n",
 				ret);
 	}
 
 	/* Disable I2C controller */
 	temp = i2c_imx->hwdata->i2cr_ien_opcode ^ I2CR_IEN,
 	imx_i2c_write_reg(temp, i2c_imx, IMX_I2C_I2CR);
+	return ret;
 }
 
 /*
@@ -1182,7 +1186,7 @@
 		temp &= ~(I2CR_MSTA | I2CR_MTX);
 		imx_i2c_write_reg(temp, i2c_imx, IMX_I2C_I2CR);
 		if (!i2c_imx->stopped)
-			i2c_imx_bus_busy(i2c_imx, 0, false);
+			i2c_imx->stop_result = i2c_imx_bus_busy(i2c_imx, 0, false);
 	} else {
 		/*
 		 * For i2c master receiver repeat restart operation like:
@@ -1340,7 +1344,7 @@
 				temp &= ~(I2CR_MSTA | I2CR_MTX);
 				imx_i2c_write_reg(temp, i2c_imx, IMX_I2C_I2CR);
 				if (!i2c_imx->stopped)
-					i2c_imx_bus_busy(i2c_imx, 0, atomic);
+					i2c_imx->stop_result = i2c_imx_bus_busy(i2c_imx, 0, atomic);
 			} else {
 				/*
 				 * For i2c master receiver repeat restart operation like:
@@ -1375,7 +1379,7 @@
 			       struct i2c_msg *msgs, int num, bool atomic)
 {
 	unsigned int i, temp;
-	int result;
+	int result, stop_ret;
 	bool is_lastmsg = false;
 	struct imx_i2c_struct *i2c_imx = i2c_get_adapdata(adapter);
 
@@ -1446,7 +1450,20 @@
 
 fail0:
 	/* Stop I2C transfer */
-	i2c_imx_stop(i2c_imx, atomic);
+	stop_ret = i2c_imx_stop(i2c_imx, atomic);
+	if (stop_ret) {
+		/* The byte may have been ACKed, but the transfer did not finish. */
+		if (result >= 0)
+			result = stop_ret;
+		/* Restore the pins before returning; never replay client data here. */
+		if (!atomic && i2c_imx->adapter.bus_recovery_info) {
+			int recovery_ret = i2c_recover_bus(&i2c_imx->adapter);
+
+			dev_warn(&i2c_imx->adapter.dev,
+				 "STOP failed: %d; bus recovery: %d\n",
+				 stop_ret, recovery_ret);
+		}
+	}
 
 	dev_dbg(&i2c_imx->adapter.dev, "<%s> exit with: %s: %d\n", __func__,
 		(result < 0) ? "error" : "success msg",
