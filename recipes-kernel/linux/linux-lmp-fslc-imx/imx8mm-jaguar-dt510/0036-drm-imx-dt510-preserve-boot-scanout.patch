Subject: [PATCH] drm/imx: DT510 take over reserved boot scanout without a reset

Upstream-Status: Inappropriate [DT510 firmware handover ABI]
Assisted-by: Briar

The retained 720p mode uses the SEC DSIM four-lane sync-pulse adjustment:
112 pixels of horizontal front porch and 1652 pixels per line. Validate
the actual U-Boot and Linux adjusted timing, not the unadjusted CEA mode.

diff --git a/drivers/gpu/imx/lcdif/lcdif-common.c b/drivers/gpu/imx/lcdif/lcdif-common.c
--- a/drivers/gpu/imx/lcdif/lcdif-common.c
+++ b/drivers/gpu/imx/lcdif/lcdif-common.c
@@ -27,10 +27,45 @@
 #include <drm/drm_fourcc.h>
 #include <video/imx-lcdif.h>
 #include <video/videomode.h>
+#include <video/dt510-handover.h>
 
 #include "lcdif-regs.h"
 
 #define DRIVER_NAME "imx8mm-lcdif"
+
+/* Built-in DT510 display path: one shared outcome, not independently trusted
+ * firmware flags in each consumer. Reject is sticky for this kernel boot.
+ */
+static atomic_t dt510_boot_failed = ATOMIC_INIT(0);
+static atomic_t dt510_boot_claims = ATOMIC_INIT(0);
+
+bool dt510_boot_display_failed(void)
+{
+	return atomic_read(&dt510_boot_failed);
+}
+EXPORT_SYMBOL_GPL(dt510_boot_display_failed);
+
+void dt510_boot_display_reject(void)
+{
+	atomic_set(&dt510_boot_failed, 1);
+}
+EXPORT_SYMBOL_GPL(dt510_boot_display_reject);
+
+void dt510_boot_display_claim(unsigned int participant)
+{
+	atomic_or(participant, &dt510_boot_claims);
+}
+EXPORT_SYMBOL_GPL(dt510_boot_display_claim);
+
+bool dt510_boot_display_retained(void)
+{
+	struct dt510_boot_display boot;
+
+	return atomic_read(&dt510_boot_claims) ==
+		(DT510_BOOT_LCDIF | DT510_BOOT_DSIM | DT510_BOOT_LT9611) &&
+		dt510_boot_display_read(&boot);
+}
+EXPORT_SYMBOL_GPL(dt510_boot_display_retained);
 
 struct lcdif_soc {
 	struct device *dev;
@@ -44,7 +79,46 @@
 	struct clk *clk_pix;
 	struct clk *clk_disp_axi;
 	struct clk *clk_disp_apb;
+	bool boot_running;
+	bool boot_pm_ref;
+	bool boot_fb_compatible;
 };
+
+void lcdif_set_boot_fb_compatible(struct lcdif_soc *lcdif, bool compatible)
+{
+	lcdif->boot_fb_compatible = compatible;
+}
+EXPORT_SYMBOL(lcdif_set_boot_fb_compatible);
+
+static bool lcdif_boot_running(struct lcdif_soc *lcdif)
+{
+	static const u32 offsets[] = { 0x30, 0x70, 0x80, 0x90, 0xa0, 0xb0 };
+	struct dt510_boot_display boot;
+	int i;
+
+	if (!dt510_boot_display_read(&boot) ||
+	    !(readl(lcdif->base + LCDIF_CTRL) & CTRL_RUN) ||
+	    readl(lcdif->base + LCDIF_CUR_BUF) != boot.address ||
+	    CTRL_GET_WORD_LENGTH(readl(lcdif->base + LCDIF_CTRL)) != 3)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(offsets); i++) {
+		int slot = i == 0 ? 2 : i + 4;
+
+		if (readl(lcdif->base + offsets[i]) != boot.lcdif[slot])
+			return false;
+	}
+	return true;
+}
+
+static void lcdif_boot_put(void *data)
+{
+	struct lcdif_soc *lcdif = data;
+
+	if (lcdif->boot_pm_ref) {
+		lcdif->boot_pm_ref = false;
+		pm_runtime_put_sync(lcdif->dev);
+	}
+}
 
 struct lcdif_soc_pdata {
 	bool hsync_invert;
@@ -437,6 +511,31 @@
 	if (unlikely(!of_id))
 		return;
 	soc_pdata = of_id->data;
+	/* CRTC enable already owns the replacement runtime-PM reference. */
+	lcdif_boot_put(lcdif);
+
+	if (lcdif->boot_running) {
+		bool keep = lcdif->boot_fb_compatible && !use_i80 &&
+			dt510_boot_display_retained() &&
+			dt510_boot_mode_matches(vmode) &&
+			clk_get_rate(lcdif->clk_pix) == vmode->pixelclock;
+
+		lcdif->boot_running = false;
+		if (keep) {
+			dev_info(lcdif->dev, "AESL HDMI handover: keeping LCDIF timings\n");
+			return;
+		}
+		dev_info(lcdif->dev,
+			 "AESL HDMI handover: fallback fb=%d i80=%d retained=%d mode=%d clock=%lu/%lu\n",
+			 lcdif->boot_fb_compatible, use_i80,
+			 dt510_boot_display_retained(),
+			 dt510_boot_mode_matches(vmode),
+			 clk_get_rate(lcdif->clk_pix),
+			 (unsigned long)vmode->pixelclock);
+		writel(0, lcdif->base + LCDIF_CTRL);
+		dt510_boot_display_reject();
+		dev_info(lcdif->dev, "AESL HDMI handover: mode mismatch, resetting LCDIF\n");
+	}
 
 	/* Clear the FIFO */
 	writel(CTRL1_FIFO_CLEAR, lcdif->base + LCDIF_CTRL1 + REG_SET);
@@ -752,13 +844,38 @@
 	pm_runtime_enable(dev);
 	atomic_inc(&lcdif->rpm_suspended);
 
+	/* Hold counted clocks/runtime PM until the first native CRTC commit.
+	 * This also protects the boot scanout from late unused-clock cleanup.
+	 */
+	{
+		struct dt510_boot_display boot;
+
+		if (dt510_boot_display_read(&boot)) {
+			lcdif->boot_running = true;
+			ret = pm_runtime_resume_and_get(dev);
+			if (ret < 0)
+				goto disable_pm;
+			lcdif->boot_pm_ref = true;
+			ret = devm_add_action_or_reset(dev, lcdif_boot_put, lcdif);
+			if (ret)
+				goto disable_pm;
+		}
+	}
+
 	dev_dbg(dev, "%s: probe end\n", __func__);
 
-	return lcdif_add_client_devices(lcdif);
+	ret = lcdif_add_client_devices(lcdif);
+	if (!ret)
+		return 0;
+	lcdif_boot_put(lcdif);
+disable_pm:
+	pm_runtime_disable(dev);
+	return ret;
 }
 
 static int imx_lcdif_remove(struct platform_device *pdev)
 {
+	lcdif_boot_put(platform_get_drvdata(pdev));
 	pm_runtime_disable(&pdev->dev);
 
 	return 0;
@@ -809,24 +926,41 @@
 	ret = lcdif_enable_clocks(lcdif);
 	if (ret) {
 		release_bus_freq(BUS_FREQ_HIGH);
+		atomic_inc(&lcdif->rpm_suspended);
+		dt510_boot_display_reject();
 		return ret;
+	}
+
+	if (lcdif->boot_running) {
+		if (lcdif_boot_running(lcdif)) {
+			dt510_boot_display_claim(DT510_BOOT_LCDIF);
+			return 0;
+		}
+		dt510_boot_display_reject();
+		lcdif->boot_running = false;
 	}
 
 	ret = lcdif_rstc_reset(lcdif->soft_resetn, false);
 	if (ret) {
 		dev_err(dev, "deassert soft_resetn failed\n");
-		return ret;
+		goto clocks_disable;
 	}
 
 	ret = lcdif_rstc_reset(lcdif->clk_enable, true);
 	if (ret) {
 		dev_err(dev, "assert clk_enable failed\n");
-		return ret;
+		goto clocks_disable;
 	}
 
 	/* Pull LCDIF out of reset */
 	writel(0x0, lcdif->base + LCDIF_CTRL);
 
+	return ret;
+clocks_disable:
+	lcdif_disable_clocks(lcdif);
+	release_bus_freq(BUS_FREQ_HIGH);
+	atomic_inc(&lcdif->rpm_suspended);
+	dt510_boot_display_reject();
 	return ret;
 }
 #endif
