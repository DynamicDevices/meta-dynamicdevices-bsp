 	if (ret)
 		goto err_poll_fini;
 
-	drm_fbdev_dma_setup(drm, legacyfb_depth);
+	{
+		struct dt510_boot_display boot;
+
+		/* A blank fbdev commit would destroy the retained boot splash.
+		 * Native DRM remains inactive in software until Weston's first
+		 * complete frame. Serial diagnostics are not affected.
+		 */
+		if (dt510_boot_display_read(&boot) &&
