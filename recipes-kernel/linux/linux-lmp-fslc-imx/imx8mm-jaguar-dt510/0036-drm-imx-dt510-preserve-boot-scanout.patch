diff --git a/include/video/dt510-handover.h b/include/video/dt510-handover.h
new file mode 100644
--- /dev/null
+++ b/include/video/dt510-handover.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _VIDEO_DT510_HANDOVER_H
+#define _VIDEO_DT510_HANDOVER_H
+
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/limits.h>
+#include <linux/string.h>
+#include <video/videomode.h>
+
+/* Private, versioned contract with the DT510 bootloader. This describes
+ * hardware still scanning a reserved allocation, not a Linux framebuffer.
+ * Linux never frees, exports, maps or reuses the bootloader allocation.
+ */
+struct dt510_boot_display {
+	u64 address;
+	u32 lcdif[10];
+};
+
+#define DT510_BOOT_LCDIF BIT(0)
+#define DT510_BOOT_DSIM BIT(1)
+#define DT510_BOOT_LT9611 BIT(2)
+bool dt510_boot_display_failed(void);
+void dt510_boot_display_reject(void);
+void dt510_boot_display_claim(unsigned int participant);
+bool dt510_boot_display_retained(void);
+
+static inline bool dt510_boot_display_read(struct dt510_boot_display *boot)
+{
+	struct device_node *node, *memory;
+	struct reserved_mem *rmem;
+	const char *format;
+	u32 width, height, stride;
+	bool valid = false;
+
+	if (dt510_boot_display_failed() ||
+	    !of_machine_is_compatible("fsl,imx8mm-jaguar-dt510"))
+		return false;
+	node = of_find_node_by_path("/chosen/aesl-boot-display");
+	if (!node)
+		return false;
+	if (!of_device_is_available(node) ||
+	    !of_device_is_compatible(node, "aesl,dt510-handover-v1") ||
+	    of_property_read_u64(node, "framebuffer-address", &boot->address) ||
+	    of_property_read_u32(node, "width", &width) ||
+	    of_property_read_u32(node, "height", &height) ||
+	    of_property_read_u32(node, "stride", &stride) ||
+	    of_property_read_string(node, "format", &format) ||
+	    width != 1280 || height != 720 || stride != 5120 ||
+	    strcmp(format, "x8r8g8b8") ||
+	    of_property_read_u32_array(node, "lcdif-registers", boot->lcdif, 10) ||
+	    !boot->address || boot->address > U32_MAX - 1280 * 720 * 4 ||
+	    boot->lcdif[3] != boot->address || !(boot->lcdif[0] & BIT(0)) ||
+	    boot->lcdif[2] != ((720U << 16) | 1280) ||
+	    (boot->lcdif[5] & 0x3ffff) != 5 || boot->lcdif[6] != 750 ||
+	    boot->lcdif[7] != ((40U << 18) | 1652) ||
+	    boot->lcdif[8] != ((260U << 16) | 25) ||
+	    (boot->lcdif[9] & 0x3ffff) != 1280)
+		goto out;
+	memory = of_parse_phandle(node, "memory-region", 0);
+	if (!memory)
+		goto out;
+	rmem = of_reserved_mem_lookup(memory);
+	valid = rmem && of_property_read_bool(memory, "no-map") &&
+		rmem->base <= boot->address &&
+		rmem->size >= 1280 * 720 * 4 &&
+		boot->address - rmem->base <= rmem->size - 1280 * 720 * 4;
+	of_node_put(memory);
+out:
+	of_node_put(node);
+	return valid;
+}
+
+static inline bool dt510_boot_mode_matches(const struct videomode *vm)
+{
+	return vm->pixelclock == 74250000 && vm->hactive == 1280 &&
+		vm->hfront_porch == 112 && vm->hsync_len == 40 &&
+		vm->hback_porch == 220 && vm->vactive == 720 &&
+		vm->vfront_porch == 5 && vm->vsync_len == 5 &&
+		vm->vback_porch == 20 &&
+		(vm->flags & DISPLAY_FLAGS_HSYNC_HIGH) &&
+		(vm->flags & DISPLAY_FLAGS_VSYNC_HIGH) &&
+		!(vm->flags & (DISPLAY_FLAGS_INTERLACED | DISPLAY_FLAGS_DOUBLESCAN));
+}
