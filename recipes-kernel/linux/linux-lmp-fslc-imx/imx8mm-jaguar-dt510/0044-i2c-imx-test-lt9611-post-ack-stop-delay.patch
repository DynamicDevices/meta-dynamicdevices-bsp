From: Briar <ajlennon@dynamicdevices.co.uk>
Subject: [PATCH] i2c: imx: test DT510 LT9611 settling after final ACK

Hold the successful page81 clock-select transaction for 50ms before STOP.
Scope the experiment to DT510's plain LT9611 and conservatively track page
selection. Exclude errors and atomic transfers; permit only 0 or 50000 us.
This tests a hypothesis, not a qualified timing requirement.

Assisted-by: Briar
---
--- a/drivers/i2c/busses/i2c-imx.c
+++ b/drivers/i2c/busses/i2c-imx.c
@@ -271,8 +271,37 @@
 		unsigned int sr, cr;
 	} irq[4];
 	unsigned int stop_sr, stop_cr;
+	bool settle_eligible;
+	unsigned int settle_requested_us;
+	u64 settle_ns;
 };
 
+/* DT510 experiment, not a qualified timing requirement. Units are microseconds. */
+static unsigned int dt510_lt9611_stop_delay_us = 50000;
+
+static int i2c_imx_dt510_set_stop_delay(const char *value,
+				      const struct kernel_param *kp)
+{
+	unsigned int delay;
+	int ret = kstrtouint(value, 0, &delay);
+
+	if (ret)
+		return ret;
+	if (delay != 0 && delay != 50000)
+		return -EINVAL;
+	WRITE_ONCE(*(unsigned int *)kp->arg, delay);
+	return 0;
+}
+
+static const struct kernel_param_ops dt510_stop_delay_ops = {
+	.set = i2c_imx_dt510_set_stop_delay,
+	.get = param_get_uint,
+};
+module_param_cb(dt510_lt9611_stop_delay_us, &dt510_stop_delay_ops,
+		&dt510_lt9611_stop_delay_us, 0644);
+MODULE_PARM_DESC(dt510_lt9611_stop_delay_us,
+	"DT510 LT9611 experiment: post-ACK/pre-STOP delay, 0 or 50000 us only");
+
 struct imx_i2c_struct {
 	struct i2c_adapter	adapter;
 	struct clk		*clk;
@@ -284,6 +313,9 @@
 	int			stopped;
 	int			stop_result;
 	struct imx_i2c_dt510_diag dt510_diag;
+	bool dt510_page_valid;
+	unsigned int dt510_page;
+	unsigned int dt510_stop_delay_this_xfer;
 	unsigned int		ifdr; /* IMX_I2C_IFDR */
 	unsigned int		cur_clk;
 	unsigned int		bitrate;
@@ -1266,6 +1298,25 @@
 		imx_i2c_read_reg(i2c_imx, IMX_I2C_I2CR));
 }
 
+static bool i2c_imx_dt510_clock_msg(struct i2c_adapter *adapter,
+				    struct i2c_msg *msgs, int num);
+
+static void i2c_imx_dt510_settle(struct imx_i2c_struct *i2c_imx,
+			       struct i2c_msg *msg, bool atomic)
+{
+	unsigned int delay = i2c_imx->dt510_stop_delay_this_xfer;
+	u64 start;
+
+	if (atomic || !delay ||
+	    !i2c_imx_dt510_clock_msg(&i2c_imx->adapter, msg, 1))
+		return;
+	/* Called only after address, data completion and every ACK succeeded. */
+	start = ktime_get_ns();
+	usleep_range(delay, delay + 1000);
+	if (READ_ONCE(i2c_imx->dt510_diag.active))
+		i2c_imx->dt510_diag.settle_ns = ktime_get_ns() - start;
+}
+
 static int i2c_imx_write(struct imx_i2c_struct *i2c_imx, struct i2c_msg *msgs,
 			 bool atomic)
 {
@@ -1305,6 +1356,7 @@
 			return result;
 		}
 	}
+	i2c_imx_dt510_settle(i2c_imx, msgs, atomic);
 	return 0;
 }
 
@@ -1675,6 +1727,47 @@
 		msgs[0].buf[0] == 0x01 && msgs[0].buf[1] == 0x18;
 }
 
+static bool i2c_imx_dt510_board(struct i2c_adapter *adapter)
+{
+	struct device_node *node;
+	u32 address;
+	bool match;
+
+	if (adapter->nr != 2 || !adapter->dev.parent || !adapter->dev.parent->of_node ||
+	    !of_machine_is_compatible("fsl,imx8mm-jaguar-dt510"))
+		return false;
+	node = of_get_child_by_name(adapter->dev.parent->of_node, "lt9611");
+	if (!node)
+		return false;
+	match = of_device_is_available(node) &&
+		of_device_is_compatible(node, "lontium,lt9611") &&
+		!of_property_read_u32(node, "reg", &address) && address == 0x39;
+	of_node_put(node);
+	return match;
+}
+
+static void i2c_imx_dt510_track_page(struct imx_i2c_struct *i2c_imx,
+				     struct i2c_msg *msgs, int num, int result)
+{
+	int i;
+
+	if (i2c_imx->adapter.nr != 2)
+		return;
+	for (i = 0; i < num; i++) {
+		if (msgs[i].addr != 0x39)
+			continue;
+		/* Only trust the immediately preceding successful standalone page
+		 * selection. Other LT access/errors invalidate this conservative hint.
+		 */
+		i2c_imx->dt510_page_valid = num == 1 && result == 1 &&
+			!(msgs[0].flags & (I2C_M_RD | I2C_M_TEN | I2C_M_RECV_LEN)) &&
+			msgs[0].len == 2 && msgs[0].buf && msgs[0].buf[0] == 0xff;
+		if (i2c_imx->dt510_page_valid)
+			i2c_imx->dt510_page = msgs[0].buf[1];
+		return;
+	}
+}
+
 static int i2c_imx_xfer(struct i2c_adapter *adapter,
 		      struct i2c_msg *msgs, int num)
 {
@@ -1684,18 +1777,31 @@
 	u64 start, elapsed;
 	unsigned int n;
 	int result;
+	bool eligible;
 
-	if (!i2c_imx_dt510_clock_msg(adapter, msgs, num))
-		return i2c_imx_xfer_raw(adapter, msgs, num);
+	i2c_imx->dt510_stop_delay_this_xfer = 0;
+	if (!i2c_imx_dt510_clock_msg(adapter, msgs, num)) {
+		result = i2c_imx_xfer_raw(adapter, msgs, num);
+		i2c_imx_dt510_track_page(i2c_imx, msgs, num, result);
+		return result;
+	}
+	eligible = i2c_imx->dt510_page_valid && i2c_imx->dt510_page == 0x81 &&
+		i2c_imx_dt510_board(adapter);
+	if (eligible)
+		i2c_imx->dt510_stop_delay_this_xfer = READ_ONCE(dt510_lt9611_stop_delay_us);
 
 	/* Adapter lock serializes transfers; slave_lock also covers the ISR. */
 	spin_lock_irqsave(&i2c_imx->slave_lock, flags);
 	memset(&i2c_imx->dt510_diag, 0, sizeof(i2c_imx->dt510_diag));
 	i2c_imx->dt510_diag.active = true;
+	i2c_imx->dt510_diag.settle_eligible = eligible;
+	i2c_imx->dt510_diag.settle_requested_us = i2c_imx->dt510_stop_delay_this_xfer;
 	spin_unlock_irqrestore(&i2c_imx->slave_lock, flags);
 	start = ktime_get_ns();
 	result = i2c_imx_xfer_raw(adapter, msgs, num);
 	elapsed = ktime_get_ns() - start;
+	i2c_imx->dt510_stop_delay_this_xfer = 0;
+	i2c_imx_dt510_track_page(i2c_imx, msgs, num, result);
 	spin_lock_irqsave(&i2c_imx->slave_lock, flags);
 	i2c_imx->dt510_diag.active = false;
 	sample = i2c_imx->dt510_diag;
@@ -1707,10 +1813,13 @@
 		 result, elapsed, i2c_imx->cur_clk, i2c_imx->ifdr,
 		 sample.waits, sample.irqs);
 	dev_info(&adapter->dev,
-		 "DT510-PHASE pm=%d/%llu idle=%d/%llu start=%d/%llu stop=%d/%llu stop_sr=%02x stop_cr=%02x units=ns\n",
+		 "DT510-PHASE pm=%d/%llu idle=%d/%llu start_initial=%d/%llu stop=%d/%llu stop_sr=%02x stop_cr=%02x units=ns\n",
 		 sample.pm_ret, sample.pm_ns, sample.idle_ret, sample.idle_ns,
 		 sample.start_ret, sample.start_ns, sample.stop_ret, sample.stop_ns,
 		 sample.stop_sr, sample.stop_cr);
+	dev_info(&adapter->dev,
+		 "DT510-SETTLE eligible=%u requested_us=%u actual_ns=%llu\n",
+		 sample.settle_eligible, sample.settle_requested_us, sample.settle_ns);
 	for (n = 0; n < min_t(unsigned int, sample.waits, ARRAY_SIZE(sample.wait)); n++)
 		dev_info(&adapter->dev,
 			 "DT510-PHASE wait=%u ns=%llu cached_sr=%02lx irqs=%u\n",
@@ -1728,6 +1837,8 @@
 	struct imx_i2c_struct *i2c_imx = i2c_get_adapdata(adapter);
 	int result;
 
+	/* Atomic accesses must neither sleep nor leave a stale page hint. */
+	i2c_imx_dt510_track_page(i2c_imx, msgs, num, -EIO);
 	result = clk_enable(i2c_imx->clk);
 	if (result)
 		return result;
