 		return result;
+	}
 	result = i2c_imx_acked(i2c_imx);
-	if (result)
+	if (result) {
+		i2c_imx_diag_error(i2c_imx, msgs, "write-address-ack", -1, result);
 		return result;
+	}
 	dev_dbg(&i2c_imx->adapter.dev, "<%s> write data\n", __func__);
 
 	/* write data */
@@ -1213,11 +1244,15 @@
 			__func__, i, msgs->buf[i]);
 		imx_i2c_write_reg(msgs->buf[i], i2c_imx, IMX_I2C_I2DR);
 		result = i2c_imx_trx_complete(i2c_imx, atomic);
-		if (result)
+		if (result) {
+			i2c_imx_diag_error(i2c_imx, msgs, "write-data-complete", i, result);
 			return result;
+		}
 		result = i2c_imx_acked(i2c_imx);
-		if (result)
+		if (result) {
+			i2c_imx_diag_error(i2c_imx, msgs, "write-data-ack", i, result);
 			return result;
+		}
 	}
 	return 0;
 }
@@ -1238,11 +1273,15 @@
 	/* write slave address */
 	imx_i2c_write_reg(i2c_8bit_addr_from_msg(msgs), i2c_imx, IMX_I2C_I2DR);
 	result = i2c_imx_trx_complete(i2c_imx, atomic);
-	if (result)
+	if (result) {
