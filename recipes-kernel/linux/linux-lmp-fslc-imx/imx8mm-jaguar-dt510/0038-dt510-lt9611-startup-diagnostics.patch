Subject: [PATCH] dt510: capture first LT9611 I2C failure without recovery changes

Temporary diagnostic build for the plain DT510 LT9611. Log failed logical
regmap operations and page selection only for device 2-0039. Report PIO
address/data completion versus ACK failures for adapter 2 address 0x39,
with error-time controller status/control snapshots. Report adapter-2 bus
wait timeouts with the existing status sample and elapsed jiffies, and log
when STOP polling fails but its result is still ignored by the legacy code.

No successful-transfer logging, additional I2C transactions, changed return
codes, retry counts, timeouts, register sequences or boot options. Error
logging and two error-time MMIO reads can perturb timing after the first
fault; software status samples are not electrical waveform proof. DMA data
failures are not phase-instrumented; bridge control writes use short PIO.
The recipe selects this only for DT510. Remove after diagnosis, alongside
the temporary switch-disabled test setting and preflight expectations.

Upstream-Status: Inappropriate [temporary DT510 startup diagnostics]
Assisted-by: Briar

--- a/drivers/i2c/busses/i2c-imx.c
+++ b/drivers/i2c/busses/i2c-imx.c
@@ -588,6 +588,12 @@
 			break;
 		}
 		if (time_after(jiffies, orig_jiffies + msecs_to_jiffies(500))) {
+			/* Temporary DT510 diagnostics; do not change the timeout/result. */
+			if (i2c_imx->adapter.nr == 2)
+				dev_err(&i2c_imx->adapter.dev,
+					"DT510-DIAG bus-wait busy=%d stopped=%d sr=%02x elapsed_ms=%u\n",
+					for_busy, i2c_imx->stopped, temp,
+					jiffies_to_msecs(jiffies - orig_jiffies));
 			dev_dbg(&i2c_imx->adapter.dev,
 				"<%s> I2C bus is busy\n", __func__);
 			return -ETIMEDOUT;
@@ -760,6 +766,7 @@
 static void i2c_imx_stop(struct imx_i2c_struct *i2c_imx, bool atomic)
 {
 	unsigned int temp = 0;
+	int ret;
 
 	if (!i2c_imx->stopped) {
 		/* Stop I2C transaction */
@@ -779,8 +786,13 @@
 		udelay(i2c_imx->disable_delay);
 	}
 
-	if (!i2c_imx->stopped)
-		i2c_imx_bus_busy(i2c_imx, 0, atomic);
+	if (!i2c_imx->stopped) {
+		ret = i2c_imx_bus_busy(i2c_imx, 0, atomic);
+		if (ret && i2c_imx->adapter.nr == 2)
+			dev_err(&i2c_imx->adapter.dev,
+				"DT510-DIAG STOP wait ret=%d (legacy result still ignored)\n",
+				ret);
+	}
 
 	/* Disable I2C controller */
 	temp = i2c_imx->hwdata->i2cr_ien_opcode ^ I2CR_IEN,
@@ -1188,6 +1200,21 @@
 	return 0;
 }
 
+/* Error-only logging on the known DT510 bridge; no extra I2C transfers. */
+static void i2c_imx_diag_error(struct imx_i2c_struct *i2c_imx,
+			       const struct i2c_msg *msg, const char *phase,
+			       int byte, int ret)
+{
+	if (!ret || i2c_imx->adapter.nr != 2 || msg->addr != 0x39)
+		return;
+
+	dev_err(&i2c_imx->adapter.dev,
+		"DT510-DIAG addr=%02x flags=%04x phase=%s byte=%d ret=%d sr=%02x cr=%02x\n",
+		msg->addr, msg->flags, phase, byte, ret,
+		imx_i2c_read_reg(i2c_imx, IMX_I2C_I2SR),
+		imx_i2c_read_reg(i2c_imx, IMX_I2C_I2CR));
+}
+
 static int i2c_imx_write(struct imx_i2c_struct *i2c_imx, struct i2c_msg *msgs,
 			 bool atomic)
 {
@@ -1199,11 +1226,15 @@
