 	result = i2c_imx_acked(i2c_imx);
-	if (result)
+	if (result) {
+		i2c_imx_diag_error(i2c_imx, msgs, "read-address-ack", -1, result);
 		return result;
+	}
 
 	dev_dbg(&i2c_imx->adapter.dev, "<%s> setup bus\n", __func__);
 
