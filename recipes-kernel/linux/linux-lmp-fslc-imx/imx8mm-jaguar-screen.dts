/*
 * Copyright 2020 NXP
 *
 * Dynamic Devices i.MX8MM Jaguar SCREEN (Active Screen / V3 Room Screen).
 *
 * Display (Michael Hull + SanTech Spec_ST1010B3CYOL-RSLW-C_RS02 + HX8279 init):
 *   native MIPI DSI 4-lane → Santek ST1010B3CYOL, panel IC Himax HX8279-D ×2.
 *   DRM mode: datasheet active 1200×1920 @60 Hz (mechanical WUXGA 1920×1200).
 *
 * CTP (2026-08-30 Michael): FocalTech FT5626 on hw I2C2;
 *   GPIO1_IO08 HI enable, GPIO1_IO09 IRQ. I2C addr 0x38 (FocalTech default).
 *
 * Backlight (2026-08-30 Michael): GPIO1_IO01 HI = max; PWM later on same pad.
 *
 * Ethernet: Microchip KSZ9131RNX (Micrel driver via PHY ID).
 *
 * SoT: lab-docs/displays/Spec_ST1010…pdf + HX8279 init TXT; schematic 202200.pdf.
 *
 * DTC notes (AESL LmP):
 *   - Use imx8mm-evk.dtsi `reg_vddext_3v3` — do not redefine it.
 *   - Delete pca9450@25 if unpatched imx8mm-evkb.dts left it alongside pmic@25
 *     (also apply linux 0004-dts-imx8mm-evkb-fix-duplicate-label.patch).
 */

#include "freescale/imx8mm-evkb.dts"
#include "imx8mm-sw_pad_ctl.h"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "i.MX8MM Jaguar SCREEN board";
	compatible = "fsl,imx8mm-jaguar-screen", "fsl,imx8mm-evk", "fsl,imx8mm";

	/* EVKB reference-audio nodes are not fitted on Jaguar SCREEN. */
	/delete-node/ sound-ak4458;
	/delete-node/ sound-ak5558;
	/delete-node/ sound-ak4497;
	/delete-node/ sound-bt-sco;
	/delete-node/ sound-micfil;
	/delete-node/ regulator-audio-board;

	/*
	 * Backlight — GPIO1_IO01 HI = maximum brightness (Michael 2026-08-30).
	 * Same pad can be remuxed to PWM1 for dimming later; gpio-backlight for
	 * first light.
	 */
	backlight_dsi: backlight-dsi {
		compatible = "gpio-backlight";
		gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
		default-on;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_dsi_bl>;
		status = "okay";
	};

	/* CTP power / enable — GPIO1_IO08 must be HI (Michael). */
	reg_ctp_en: regulator-ctp-en {
		compatible = "regulator-fixed";
		regulator-name = "ctp-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio1 8 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ctp_en>;
	};
};

/* Unpatched EVKB leaves pca9450@25 + pmic@25 → duplicate buck/ldo labels. */
&i2c1 {
	/delete-node/ pca9450@25;
};

/* AX210 Wi-Fi uses PCIe; its unfitted Bluetooth USB path is not UART1. */
&uart1 {
	status = "disabled";
	/delete-node/ bluetooth;
};

/*
 * EVK ADV7535 DSI→HDMI is not the Active Screen path. Remove so &mipi_dsi
 * can be rewired to the HX8279-D panel. CTP FT5626 lives on this bus.
 */
&i2c2 {
	/* Properties must precede subnodes (dtc). */
	clock-frequency = <400000>;
	status = "okay";

	/*
	 * EVK ADV7535 lives at adv7535@3d (binds as adv7511) — NOT hdmi@3d.
	 * Delete the node (not just status=disabled): a disabled node still keeps
	 * its port endpoint phandle to dsim_to_adv7535, which breaks dtc once we
	 * rewire MIPI port@1 to the panel. Also frees GPIO1_IO09 for CTP IRQ.
	 */
	/delete-node/ adv7535@3d;

	touchscreen@38 {
		/* FT5626 silicon; LmP 6.6.52 edt-ft5x06 has edt,edt-ft5506 (no focaltech,ft5426). */
		compatible = "edt,edt-ft5506";
		reg = <0x38>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ctp_int>;
		interrupt-parent = <&gpio1>;
		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
		vcc-supply = <&reg_ctp_en>;
		iovcc-supply = <&reg_ctp_en>;
		/* Mechanical WUXGA landscape; native panel scan is 1200×1920. */
		touchscreen-size-x = <1920>;
		touchscreen-size-y = <1200>;
		status = "okay";
	};
};

/* Remove unfitted EVKB reference audio and GPIO expander devices. */
&i2c3 {
	/delete-node/ ak4458@10;
	/delete-node/ ak4497@11;
	/delete-node/ ak4458@12;
	/delete-node/ ak5558@13;
	/delete-node/ gpio@20;
};

/* EVK pwm-backlight node — replaced by gpio-backlight on GPIO1_IO01 for now. */
&backlight {
	status = "disabled";
};

/* EVKB PDM microphones are not fitted on Jaguar SCREEN. */
&micfil {
	status = "disabled";
};

&iomuxc {
	/*
	 * Display / CTP GPIOs (Michael Hull 2026-08-30 + schematic 202200.pdf):
	 *   GPIO1_IO01  backlight max (HI); PWM later
	 *   GPIO1_IO08  DSI_EN     — CTP enable (HI)
	 *   GPIO1_IO09  DSI_INT    — CTP interrupt
	 *   GPIO1_IO12  DSI_EN_2   — LCD load switch EN (TPS22913B); HI = LCD on
	 *
	 * MIPI DSI data: D0–D3 + CLK (4-lane) on SoC MIPI_DSI_* balls.
	 */
	pinctrl_dsi_bl: dsiblgrp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO01_GPIO1_IO1	0x116
		>;
	};

	pinctrl_dsi_lcd_en: dsilcdengrp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO12_GPIO1_IO12	0x116
		>;
	};

	pinctrl_ctp_en: ctpengrp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO08_GPIO1_IO8	0x116
		>;
	};

	pinctrl_ctp_int: ctpintrgrp {
		fsl,pins = <
			MX8MM_IOMUXC_GPIO1_IO09_GPIO1_IO9	0x16
		>;
	};

	/* imx8mm-evkb.dts leaves USDHC3 disabled; restore the EVK eMMC pins. */
	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK       IMX8MM_PAD_USDHC_CLK
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD       IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0   IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1   IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2   IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3   IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4     IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5    IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6    IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_CLE_USDHC3_DATA7      IMX8MM_PAD_USDHC_BUS
			MX8MM_IOMUXC_NAND_CE1_B_USDHC3_STROBE   IMX8MM_PAD_USDHC_CLK
		>;
	};

	pinctrl_usdhc3_100mhz: usdhc3-100mhzgrp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK       IMX8MM_PAD_USDHC_CLK_100MHZ
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD       IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0   IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1   IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2   IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3   IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4     IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5    IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6    IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_CLE_USDHC3_DATA7      IMX8MM_PAD_USDHC_BUS_100MHZ
			MX8MM_IOMUXC_NAND_CE1_B_USDHC3_STROBE   IMX8MM_PAD_USDHC_CLK_100MHZ
		>;
	};

	pinctrl_usdhc3_200mhz: usdhc3-200mhzgrp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK       IMX8MM_PAD_USDHC_CLK_200MHZ
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD       IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0   IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1   IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2   IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3   IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4     IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5    IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6    IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_CLE_USDHC3_DATA7      IMX8MM_PAD_USDHC_BUS_200MHZ
			MX8MM_IOMUXC_NAND_CE1_B_USDHC3_STROBE   IMX8MM_PAD_USDHC_CLK_200MHZ
		>;
	};
};

/* On-board 8-bit eMMC; Linux root filesystem is /dev/mmcblk2p2. */
&usdhc3 {
	assigned-clocks = <&clk IMX8MM_CLK_USDHC3_ROOT>;
	assigned-clock-rates = <400000000>;
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
	bus-width = <8>;
	non-removable;
	status = "okay";
};

/*
 * Display — ST1010B3CYOL module, Himax HX8279-D
 *
 *   - Native MIPI DSI 4-lane (NOT LVDS).
 *   - Datasheet timing: 1200×1920 @60 Hz, ~156 MHz, 4 lanes (RS02 §4).
 *   - DSI_EN_2 (GPIO1_IO12) HI → LCD power path.
 *   - Init: HX8279-D vendor sequence via panel-boe-himax8279d.
 */
&mipi_dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/*
	 * Keep SoC port@0 (dsim_from_lcdif ↔ lcdif_to_dsim). Deleting it breaks
	 * lcdif phandle resolution. Only drop EVK port@1 (dsim_to_adv7535) and
	 * reattach flat port@1 to the HX8279 panel (same shape as EVK→ADV).
	 */
	/delete-node/ port@1;

	panel@0 {
		compatible = "santek,st1010b3cyol", "himax,hx8279d";
		reg = <0>;
		status = "okay";
		/* Native portrait scan is mounted with its right edge uppermost. */
		rotation = <90>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_dsi_lcd_en>;
		/* DSI_EN_2 → TPS22913B EN; active-high per Michael. */
		enable-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		backlight = <&backlight_dsi>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mipi_dsi_out>;
			};
		};
	};

	port@1 {
		mipi_dsi_out: endpoint {
			remote-endpoint = <&panel_in>;
			data-lanes = <1 2 3 4>;
		};
	};
};

/*
 * Ethernet — Microchip KSZ9131RNX on FEC RGMII (Michael 2026-08-30).
 * Keep EVK fec1 pinmux / reset; bind Micrel driver via PHY ID.
 */
&ethphy0 {
	compatible = "ethernet-phy-id0022.1640", "ethernet-phy-ieee802.3-c22";
	/delete-property/ qca,disable-smarteee;
};
