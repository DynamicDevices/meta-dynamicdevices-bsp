From: Alex Lennon <ajlennon@dynamicdevices.co.uk>
Date: Sun, 30 Aug 2026 12:20:00 +0100
Subject: [PATCH] drm/panel: boe-himax8279d: add Santek ST1010 / HX8279-D

Active Screen first light: ST1010 RS02 timings (1200x1920@60), vendor
HX8279 init including bank-09 delay 5, of_match santek/himax.

Assisted-by: Cursor <cursoragent@cursor.com>

---
--- a/drivers/gpu/drm/panel/panel-boe-himax8279d.c
+++ b/drivers/gpu/drm/panel/panel-boe-himax8279d.c
@@ -57,10 +57,15 @@
 static void disable_gpios(struct panel_info *pinfo)
 {
 	gpiod_set_value(pinfo->enable_gpio, 0);
-	gpiod_set_value(pinfo->pp33_gpio, 0);
-	gpiod_set_value(pinfo->pp18_gpio, 0);
+	if (pinfo->pp33_gpio)
+		gpiod_set_value(pinfo->pp33_gpio, 0);
+	if (pinfo->pp18_gpio)
+		gpiod_set_value(pinfo->pp18_gpio, 0);
 }
 
+/* cmd == 0xff: data is delay in milliseconds (vendor init "delay N") */
+#define PANEL_CMD_DELAY		0xff
+
 static int send_mipi_cmds(struct drm_panel *panel, const struct panel_cmd *cmds)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
@@ -68,6 +73,11 @@
 	int err;
 
 	for (i = 0; i < pinfo->desc->on_cmds_num; i++) {
+		if (cmds[i].cmd == PANEL_CMD_DELAY) {
+			msleep(cmds[i].data);
+			continue;
+		}
+
 		err = mipi_dsi_dcs_write_buffer(pinfo->link, &cmds[i],
 						sizeof(struct panel_cmd));
 
@@ -118,12 +128,14 @@
 	struct panel_info *pinfo = to_panel_info(panel);
 	int err;
 
-	gpiod_set_value(pinfo->pp18_gpio, 1);
+	if (pinfo->pp18_gpio)
+		gpiod_set_value(pinfo->pp18_gpio, 1);
 	/* T1: 5ms - 6ms */
 	usleep_range(5000, 6000);
-	gpiod_set_value(pinfo->pp33_gpio, 1);
+	if (pinfo->pp33_gpio)
+		gpiod_set_value(pinfo->pp33_gpio, 1);
 
-	/* reset sequence */
+	/* enable / power-cycle sequence (Active Screen: DSI_EN2 load switch) */
 	/* T2: 14ms - 15ms */
 	usleep_range(14000, 15000);
 	gpiod_set_value(pinfo->enable_gpio, 1);
@@ -809,6 +821,334 @@
 	.on_cmds_num = 283,
 };
 
+/*
+ * Santek ST1010B3CYOL-RSLW-C (10.1" WUXGA) + Himax HX8279-D
+ * Init: Michael Hull "1_HX8279-D initial code_ 10.1WU …" (DEV WA 2026-08-08).
+ * Mode: Spec_ST1010B3CYOL-RSLW-C_RS02 §4 — native 1200×1920 @60 Hz / 156 MHz.
+ * Mechanical outline is WUXGA 1920×1200. H typ tHP=1340; V typ tvp=1944.
+ */
+static const struct drm_display_mode santek_st1010_display_mode = {
+	/* Spec_ST1010B3CYOL-RSLW-C_RS02 §4: native 1200x1920 @60Hz, 156MHz, 4-lane */
+	.clock = 156000,
+	.hdisplay = 1200,
+	.hsync_start = 1200 + 60,
+	.hsync_end = 1200 + 60 + 24,
+	.htotal = 1340,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 17,
+	.vsync_end = 1920 + 17 + 2,
+	.vtotal = 1944,
+};
+
