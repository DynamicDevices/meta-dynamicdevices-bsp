From e16de4fb3544c2782f4a5fb4c080efa736724216 Mon Sep 17 00:00:00 2001
From: Alex Lennon <ajlennon@dynamicdevices.co.uk>
Date: Sun, 6 Sep 2026 13:24:57 +0100
Subject: [PATCH] drm/panel: add proven Santek ST1010 HX8279-D support

---
 drivers/gpu/drm/panel/panel-boe-himax8279d.c | 386 ++++++++++++++++++-
 1 file changed, 378 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-boe-himax8279d.c b/drivers/gpu/drm/panel/panel-boe-himax8279d.c
index 11b64acbe8a9..0ae409311e1e 100644
--- a/drivers/gpu/drm/panel/panel-boe-himax8279d.c
+++ b/drivers/gpu/drm/panel/panel-boe-himax8279d.c
@@ -37,6 +37,10 @@ struct panel_desc {
 	unsigned int lanes;
 	const struct panel_cmd *on_cmds;
 	unsigned int on_cmds_num;
+	bool use_generic_init_cmds;
+	/* Some boards wire enable to a power switch, not the panel reset pin. */
+	bool enable_gpio_is_power;
+	unsigned int enable_power_on_delay_ms;
 };
 
 struct panel_info {
@@ -60,10 +64,15 @@ static inline struct panel_info *to_panel_info(struct drm_panel *panel)
 static void disable_gpios(struct panel_info *pinfo)
 {
 	gpiod_set_value(pinfo->enable_gpio, 0);
-	gpiod_set_value(pinfo->pp33_gpio, 0);
-	gpiod_set_value(pinfo->pp18_gpio, 0);
+	if (pinfo->pp33_gpio)
+		gpiod_set_value(pinfo->pp33_gpio, 0);
+	if (pinfo->pp18_gpio)
+		gpiod_set_value(pinfo->pp18_gpio, 0);
 }
 
+/* cmd == 0xff: data is delay in milliseconds (vendor init "delay N") */
+#define PANEL_CMD_DELAY		0xff
+
 static int send_mipi_cmds(struct drm_panel *panel, const struct panel_cmd *cmds)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
@@ -71,8 +80,17 @@ static int send_mipi_cmds(struct drm_panel *panel, const struct panel_cmd *cmds)
 	int err;
 
 	for (i = 0; i < pinfo->desc->on_cmds_num; i++) {
-		err = mipi_dsi_dcs_write_buffer(pinfo->link, &cmds[i],
-						sizeof(struct panel_cmd));
+		if (cmds[i].cmd == PANEL_CMD_DELAY) {
+			msleep(cmds[i].data);
+			continue;
+		}
+
+		if (pinfo->desc->use_generic_init_cmds)
+			err = mipi_dsi_generic_write(pinfo->link, &cmds[i],
+						     sizeof(struct panel_cmd));
+		else
+			err = mipi_dsi_dcs_write_buffer(pinfo->link, &cmds[i],
+							sizeof(struct panel_cmd));
 
 		if (err < 0)
 			return err;
@@ -134,10 +152,17 @@ static int boe_panel_prepare(struct drm_panel *panel)
 	if (pinfo->prepared)
 		return 0;
 
-	gpiod_set_value(pinfo->pp18_gpio, 1);
+	if (pinfo->pp18_gpio)
+		gpiod_set_value(pinfo->pp18_gpio, 1);
 	/* T1: 5ms - 6ms */
 	usleep_range(5000, 6000);
-	gpiod_set_value(pinfo->pp33_gpio, 1);
+	if (pinfo->pp33_gpio)
+		gpiod_set_value(pinfo->pp33_gpio, 1);
+	if (pinfo->desc->enable_gpio_is_power) {
+		gpiod_set_value(pinfo->enable_gpio, 1);
+		msleep(pinfo->desc->enable_power_on_delay_ms);
+		goto send_init;
+	}
 
 	/* reset sequence */
 	/* T2: 14ms - 15ms */
@@ -155,6 +180,7 @@ static int boe_panel_prepare(struct drm_panel *panel)
 	/* T5: 5ms - 6ms */
 	usleep_range(5000, 6000);
 
+send_init:
 	/* send init code */
 	err = send_mipi_cmds(panel, pinfo->desc->on_cmds);
 	if (err < 0) {
@@ -832,6 +858,341 @@ static const struct panel_desc boe_himax8279d10p_panel_desc = {
 	.on_cmds_num = 283,
 };
 
+/*
+ * Santek ST1010B3CYOL-RSLW-C (10.1" WUXGA) + Himax HX8279-D
+ * Init: Michael Hull "1_HX8279-D initial code_ 10.1WU …" (DEV WA 2026-08-08).
+ * Mode: 1920x1200@~60Hz — BOE 10p pixel clock / porch budget transposed to
+ * landscape WUXGA (A02 "Pixels H×V 1920×1200×3"). Confirm on scope / datasheet.
+ * PENDING: Android display driver from Michael (correct DRM timings for
+ * Active Screen / ST1010 / HX8279) — ask DEV WA after 2026-08-09 10:00 UK.
+ */
+static const struct drm_display_mode santek_st1010_display_mode = {
+	/* Upstream Aoly SL101PM1794FOG-V15 HX8279 mode, 1200x1920 @60Hz */
