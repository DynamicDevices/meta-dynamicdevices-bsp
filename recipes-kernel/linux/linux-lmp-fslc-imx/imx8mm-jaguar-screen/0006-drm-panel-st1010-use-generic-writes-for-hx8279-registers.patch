From: Alex Lennon <ajlennon@dynamicdevices.co.uk>
Subject: [PATCH] drm/panel: st1010: use generic writes for HX8279 registers

The HX8279-D datasheet section 8.1 specifies MIPI generic short-write
packets for its internal register interface.  The inherited BOE panel
driver sends every two-byte initialization entry as a DCS short write.
That leaves the ST1010's dual HX8279 gate drivers at partially configured
power-on defaults, producing bright fields and repeated horizontal lines
even when the framebuffer contains one constant colour.

Select generic writes only for the ST1010 descriptor.  Preserve the
existing DCS-write behaviour for the BOE panels using this driver.

---
 drivers/gpu/drm/panel/panel-boe-himax8279d.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

--- a/drivers/gpu/drm/panel/panel-boe-himax8279d.c
+++ b/drivers/gpu/drm/panel/panel-boe-himax8279d.c
@@ -35,6 +35,7 @@ struct panel_desc {
 	unsigned int lanes;
 	const struct panel_cmd *on_cmds;
 	unsigned int on_cmds_num;
+	bool use_generic_init_cmds;
 	/* Some boards wire enable to a power switch, not the panel reset pin. */
 	bool enable_gpio_is_power;
 	unsigned int enable_power_on_delay_ms;
@@ -78,8 +79,12 @@ static int send_mipi_cmds(struct drm_panel *panel, const struct panel_cmd *cmds)
 			continue;
 		}
 
-		err = mipi_dsi_dcs_write_buffer(pinfo->link, &cmds[i],
-						sizeof(struct panel_cmd));
+		if (pinfo->desc->use_generic_init_cmds)
+			err = mipi_dsi_generic_write(pinfo->link, &cmds[i],
+						     sizeof(struct panel_cmd));
+		else
+			err = mipi_dsi_dcs_write_buffer(pinfo->link, &cmds[i],
+							sizeof(struct panel_cmd));
 
 		if (err < 0)
 			return err;
@@ -1158,5 +1163,6 @@ static const struct panel_desc santek_st1010_hx8279d_panel_desc = {
 	.on_cmds = santek_st1010_hx8279d_on_cmds,
 	.on_cmds_num = ARRAY_SIZE(santek_st1010_hx8279d_on_cmds),
+	.use_generic_init_cmds = true,
 	/* GPIO1_IO12 controls the LCD power switch, it is not RESET. */
 	.enable_gpio_is_power = true,
 	.enable_power_on_delay_ms = 10,
-- 
