From 4d9633455ad5eb1b4aa09225506c350b335e26f5 Mon Sep 17 00:00:00 2001
From: Alex Lennon <ajlennon@dynamicdevices.co.uk>
Date: Tue, 1 Sep 2026 18:30:00 +0100
Subject: [PATCH] net: phy: micrel: verify KSZ9131 RGMII delay programming

The KSZ9131RNX on imx8mm-jaguar-screen boots with the TX clock DLL
disable bit set even though the interface is configured as rgmii-id.
External receive traffic works, but transmitted DHCP packets never reach
the network. Clearing bit 12 of MMD 2 register 77 restores Ethernet
immediately and reproducibly.

Program the RGMII delay controls after the remaining PHY setup and verify
their masked values. Retry once if the first write did not stick, then
report an error rather than silently leaving a half-configured RGMII link.

Signed-off-by: Alex Lennon <ajlennon@dynamicdevices.co.uk>
---
 drivers/net/phy/micrel.c | 57 +++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 52 insertions(+), 5 deletions(-)

diff --git a/drivers/net/phy/micrel.c b/drivers/net/phy/micrel.c
index 64926240b007..3a68b3b4768e 100644
--- a/drivers/net/phy/micrel.c
+++ b/drivers/net/phy/micrel.c
@@ -1321,6 +1321,6 @@ static int ksz9131_config_rgmii_delay(struct phy_device *phydev)
 	const struct kszphy_type *type = phydev->drv->driver_data;
 	u16 rxcdll_val, txcdll_val;
-	int ret;
+	int ret, rxcdll, txcdll;
 
 	switch (phydev->interface) {
 	case PHY_INTERFACE_MODE_RGMII:
@@ -1350,9 +1350,53 @@ static int ksz9131_config_rgmii_delay(struct phy_device *phydev)
 	if (ret < 0)
 		return ret;
 
-	return phy_modify_mmd(phydev, KSZ9131RN_MMD_COMMON_CTRL_REG,
-			      KSZ9131RN_TXC_DLL_CTRL, type->disable_dll_mask,
-			      txcdll_val);
+	ret = phy_modify_mmd(phydev, KSZ9131RN_MMD_COMMON_CTRL_REG,
+			     KSZ9131RN_TXC_DLL_CTRL, type->disable_dll_mask,
+			     txcdll_val);
+	if (ret < 0)
+		return ret;
+
+	rxcdll = phy_read_mmd(phydev, KSZ9131RN_MMD_COMMON_CTRL_REG,
+			      KSZ9131RN_RXC_DLL_CTRL);
+	if (rxcdll < 0)
+		return rxcdll;
+
+	txcdll = phy_read_mmd(phydev, KSZ9131RN_MMD_COMMON_CTRL_REG,
+			      KSZ9131RN_TXC_DLL_CTRL);
+	if (txcdll < 0)
+		return txcdll;
+
+	if ((rxcdll & type->disable_dll_mask) == rxcdll_val &&
+	    (txcdll & type->disable_dll_mask) == txcdll_val)
+		return 0;
+
+	ret = phy_modify_mmd(phydev, KSZ9131RN_MMD_COMMON_CTRL_REG,
+			     KSZ9131RN_RXC_DLL_CTRL, type->disable_dll_mask,
+			     rxcdll_val);
+	if (ret < 0)
+		return ret;
+
+	ret = phy_modify_mmd(phydev, KSZ9131RN_MMD_COMMON_CTRL_REG,
+			     KSZ9131RN_TXC_DLL_CTRL, type->disable_dll_mask,
+			     txcdll_val);
+	if (ret < 0)
+		return ret;
+
+	rxcdll = phy_read_mmd(phydev, KSZ9131RN_MMD_COMMON_CTRL_REG,
+			      KSZ9131RN_RXC_DLL_CTRL);
+	if (rxcdll < 0)
+		return rxcdll;
+
+	txcdll = phy_read_mmd(phydev, KSZ9131RN_MMD_COMMON_CTRL_REG,
+			      KSZ9131RN_TXC_DLL_CTRL);
+	if (txcdll < 0)
+		return txcdll;
+
+	if ((rxcdll & type->disable_dll_mask) != rxcdll_val ||
+	    (txcdll & type->disable_dll_mask) != txcdll_val)
+		return -EIO;
+
+	return 0;
 }
 
 /* Silicon Errata DS80000693B
@@ -1436,7 +1480,10 @@ static int ksz9131_config_init(struct phy_device *phydev)
 	if (ret < 0)
 		return ret;
 
-	return 0;
+	if (!phy_interface_is_rgmii(phydev))
+		return 0;
+
+	return ksz9131_config_rgmii_delay(phydev);
 }
 
 #define MII_KSZ9131_AUTO_MDIX		0x1C
-- 
2.43.0
