+	if (block->mnCommands > reader->remaining / 4 ||
+		block->mnCommands > UINT_MAX / 4) {
+		reader->error = -EBADMSG;
+		return;
+	}
+	length = (size_t)block->mnCommands * 4;
+	data = fw_take(reader, length);
+	reader->error = fw_commands_valid(data, block->mnCommands);
+	if (reader->error || !length)
+		return;
+	block->mpData = kmemdup(data, length, GFP_KERNEL);
+	if (!block->mpData)
+		reader->error = -ENOMEM;
+}
+
+static void fw_image(struct tas2555_fw_reader *reader,
+	struct TFirmware *firmware, struct TData *image)
+{
+	unsigned int index;
+
+	fw_name(reader, image->mpName);
+	image->mpDescription = fw_description(reader);
+	image->mnBlocks = fw_integer(reader, 2);
+	image->mpBlocks = fw_array(reader, image->mnBlocks,
+		sizeof(*image->mpBlocks), 8);
+	for (index = 0; index < image->mnBlocks && !reader->error; index++)
+		fw_block(reader, firmware, &image->mpBlocks[index]);
+}
+
+static int fw_parse(struct tas2555_priv *device, struct TFirmware *firmware,
+	unsigned char *data, size_t size)
+{
+	struct tas2555_fw_reader reader = { data, size, 0 };
+	const unsigned char magic[] = { 0x35, 0x35, 0x35, 0x32 };
+	const unsigned char *signature;
+	unsigned int index;
+
+	signature = fw_take(&reader, sizeof(magic));
+	if (!signature || memcmp(signature, magic, sizeof(magic)))
+		return -EBADMSG;
+	firmware->mnFWSize = fw_integer(&reader, 4);
+	firmware->mnChecksum = fw_integer(&reader, 4);
+	firmware->mnPPCVersion = fw_integer(&reader, 4);
+	firmware->mnFWVersion = fw_integer(&reader, 4);
+	if (firmware->mnPPCVersion >= PPC_WITH_DRIVER_VERSION)
+		firmware->mnDriverVersion = fw_integer(&reader, 4);
+	firmware->mnTimeStamp = fw_integer(&reader, 4);
+	fw_name(&reader, firmware->mpDDCName);
+	firmware->mpDescription = fw_description(&reader);
+	firmware->mnDeviceFamily = fw_integer(&reader, 4);
+	firmware->mnDevice = fw_integer(&reader, 4);
+	if (reader.error)
+		goto failed;
+
+	firmware->mnPLLs = fw_integer(&reader, 2);
+	firmware->mpPLLs = fw_array(&reader, firmware->mnPLLs,
+		sizeof(*firmware->mpPLLs), 73);
+	for (index = 0; index < firmware->mnPLLs && !reader.error; index++) {
+		struct TPLL *pll = &firmware->mpPLLs[index];
+
+		fw_name(&reader, pll->mpName);
+		pll->mpDescription = fw_description(&reader);
+		fw_block(&reader, firmware, &pll->mBlock);
+	}
+
+	firmware->mnPrograms = fw_integer(&reader, 2);
+	firmware->mpPrograms = fw_array(&reader, firmware->mnPrograms,
+		sizeof(*firmware->mpPrograms), 132);
+	for (index = 0; index < firmware->mnPrograms && !reader.error; index++) {
+		struct TProgram *program = &firmware->mpPrograms[index];
+
+		fw_name(&reader, program->mpName);
+		program->mpDescription = fw_description(&reader);
+		if (firmware->mnDriverVersion >= PPC_WITH_APPMODE_VERSION) {
+			program->mnAppMode = fw_integer(&reader, 1);
+			program->mnBoost = fw_integer(&reader, 2);
+		} else {
+			program->mnAppMode = 0xff;
+			program->mnBoost = 0xffff;
+		}
+		fw_image(&reader, firmware, &program->mData);
 	}
 
