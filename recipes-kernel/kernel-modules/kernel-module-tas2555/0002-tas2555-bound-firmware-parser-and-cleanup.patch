+	firmware->mnConfigurations = fw_integer(&reader, 2);
+	firmware->mpConfigurations = fw_array(&reader, firmware->mnConfigurations,
+		sizeof(*firmware->mpConfigurations), 138);
+	for (index = 0; index < firmware->mnConfigurations && !reader.error; index++) {
+		struct TConfiguration *configuration = &firmware->mpConfigurations[index];
+
+		fw_name(&reader, configuration->mpName);
