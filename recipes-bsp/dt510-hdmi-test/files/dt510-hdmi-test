#!/usr/bin/env python3
"""Display the native 1080p overscan pattern, or restore the saved text console.

No mode/driver changes. Run as root: dt510-hdmi-test show|console|restore|info.
The PNG is also available under /usr/share/dt510-hdmi-test/ for other viewers.
"""
import argparse
import fcntl
import gzip
import json
import mmap
import os
from pathlib import Path
import signal
import stat
import struct

DATA = Path('/usr/share/dt510-hdmi-test')
STATE = Path('/run/dt510-hdmi-test')
FRAME_BYTES = 1920 * 1080 * 4


def validate_geometry(words, stride):
    if tuple(words[:7]) != (1920, 1080, 1920, words[3], 0, 0, 32):
        raise RuntimeError('Requires native 1920x1080, 32bpp, zero offsets; no mode change attempted')
    if words[3] < 1080 or tuple(words[8:17]) != (16, 8, 0, 8, 8, 0, 0, 8, 0) or stride != 7680:
        raise RuntimeError('Unsupported framebuffer geometry/pixel format; no writes attempted')


def read_pattern(path):
    with gzip.open(path, 'rb') as asset:
        pixels = asset.read(FRAME_BYTES + 1)
    if len(pixels) != FRAME_BYTES:
        raise RuntimeError('Invalid pattern payload length')
    return pixels


def console_rows(rows, columns):
    if not (3 <= rows <= 255 and 16 <= columns <= 255):
        raise RuntimeError('Unsupported text-console dimensions')
    alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    lines = []
    for row in range(rows):
        left, right = f'L{row:03d}|', f'|R{row:03d}'
        if row == 0:
            left, right = 'TL|', '|TR'
        elif row == rows-1:
            left, right = 'BL|', '|BR'
        count = columns-len(left)-len(right)
        body = ''.join(alphabet[(row+col) % len(alphabet)] for col in range(count))
        lines.append(left+body+right)
    return lines


def console_payload(original):
    if len(original) < 4:
        raise RuntimeError('Invalid VCSA header')
    rows, columns = original[:2]
    if len(original) != 4+2*rows*columns:
        raise RuntimeError('Invalid VCSA snapshot size')
    lines = console_rows(rows, columns)
    # Write real console character cells, not an image. This avoids automatic
    # wrapping/scrolling, including at the final column of the bottom row.
    header = bytes((rows, columns, columns//2, rows//2))
    cells = b''.join(bytes((ord(char), 0x0f)) for line in lines for char in line)
    return header+cells


def interrupted(signum, frame):
    raise InterruptedError(f'Interrupted by signal {signum}')


def save_and_apply(backup, state, original, metadata, apply, rollback):
    # Include backup creation itself in interruption handling. Restore from the
    # complete in-memory snapshot, never from a possibly partial disk backup.
    try:
        with backup.open('xb') as saved:
            saved.write(original)
        with state.open('x') as saved:
            json.dump(metadata, saved)
        apply()
    except BaseException:
        # If rollback fails, retain the available recovery files.
        rollback()
        backup.unlink(missing_ok=True)
        state.unlink(missing_ok=True)
        raise


def run(action):
    if os.geteuid() != 0:
        raise RuntimeError('Run as root (sudo dt510-hdmi-test ' + action + ')')
    lock_fd = os.open('/run/lock/dt510-hdmi-experiment.lock',
                      os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock_fd, 'r+b') as lock:
        if os.fstat(lock.fileno()).st_uid != 0:
            raise RuntimeError('Experiment lock must be root-owned')
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if Path('/sys/class/graphics/fb0/name').read_text().strip() != 'imx-drmdrmfb':
            raise RuntimeError('Expected the i.MX DRM framebuffer')
        STATE.mkdir(mode=0o700, exist_ok=True)
        st = STATE.lstat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o700:
            raise RuntimeError('State directory must be a root-owned, private directory')
        with open('/dev/fb0', 'r+b', buffering=0) as fb:
            var = bytearray(160)
            fcntl.ioctl(fb, 0x4600, var)
            words = struct.unpack('40I', var)
            stride = int(Path('/sys/class/graphics/fb0/stride').read_text())
            print(json.dumps({'width': words[0], 'height': words[1], 'bpp': words[6],
                              'offset': list(words[4:6]), 'stride': stride}))
            if action == 'info':
                return
            validate_geometry(words, stride)
            active = Path('/sys/class/tty/tty0/active').read_text().strip()
            if not active.startswith('tty') or not active[3:].isdigit():
                raise RuntimeError('Expected an active Linux virtual console')
            backup, state = STATE / 'console.bin', STATE / 'state.json'
            if backup.exists() != state.exists():
                raise RuntimeError('Incomplete saved test; no display writes attempted. '
                                   'Reboot clears temporary /run state and restores the normal console')
            with open('/dev/' + active, 'r+b', buffering=0) as tty, mmap.mmap(
                    fb.fileno(), FRAME_BYTES, access=mmap.ACCESS_WRITE) as screen:
                if action in ('show', 'console'):
                    if backup.exists() or state.exists():
                        raise RuntimeError('A saved test exists; run dt510-hdmi-test restore first')
                    # Refuse to take the display from any userspace DRM client.
                    clients = Path('/sys/kernel/debug/dri/0/clients').read_text().strip().splitlines()
                    if len(clients) != 1:
                        raise RuntimeError('DRM userspace clients are active; stop them explicitly first')
                    mode = bytearray(4)
                    fcntl.ioctl(tty, 0x4B3B, mode)  # KDGETMODE
                    original = struct.unpack('I', mode)[0]
                    if original != 0:
                        raise RuntimeError('Console is already in graphics mode')
                    if action == 'console':
                        vcsa = Path('/dev/vcsa' + active[3:])
                        original_cells = vcsa.read_bytes()
                        payload = console_payload(original_cells)
                        def apply_cells():
                            with vcsa.open('r+b', buffering=0) as cells:
                                if cells.write(payload) != len(payload):
                                    raise RuntimeError('Incomplete console test write')
                        def restore_cells():
                            with vcsa.open('r+b', buffering=0) as cells:
                                if cells.write(original_cells) != len(original_cells):
                                    raise RuntimeError('Incomplete console rollback; recovery files retained')
                        save_and_apply(backup, state, original_cells,
                                       {'tty': active, 'mode': original,
                                        'var': list(words), 'stride': stride, 'type': 'console'},
                                       apply_cells, restore_cells)
                        print(f'Text console filled: {payload[1]} columns x {payload[0]} rows.')
                        print('Corners TL/TR/BL/BR and every Lnnn/Rnnn row marker must be visible.')
                        print('Restore with: sudo dt510-hdmi-test restore')
                        return
                    pixels = read_pattern(DATA / 'overscan-1920x1080.bgrx.gz')
                    original_pixels = screen[:]
                    def apply_pixels():
                        fcntl.ioctl(tty, 0x4B3A, 1)  # KD_GRAPHICS prevents console overwrites
                        screen[:] = pixels
                    def restore_pixels():
                        try:
                            screen[:] = original_pixels
                        finally:
                            fcntl.ioctl(tty, 0x4B3A, original)
                    save_and_apply(backup, state, original_pixels,
                                   {'tty': active, 'mode': original,
                                    'var': list(words), 'stride': stride},
                                   apply_pixels, restore_pixels)
                    print('Pattern displayed. White must reach all four edges; each band is 16 pixels.')
                    print('Restore with: sudo dt510-hdmi-test restore (or reboot).')
                else:
                    saved = json.loads(state.read_text())
                    if saved['tty'] != active or saved['var'] != list(words) or saved['stride'] != stride:
                        raise RuntimeError('Console or framebuffer changed; refusing stale restoration')
                    pixels = backup.read_bytes()
                    if saved.get('type') == 'console':
                        vcsa = Path('/dev/vcsa' + active[3:])
                        current = vcsa.read_bytes()
                        if len(current) != len(pixels) or current[:2] != pixels[:2]:
                            raise RuntimeError('Text-console dimensions changed; refusing stale restoration')
                        with vcsa.open('r+b', buffering=0) as cells:
                            if cells.write(pixels) != len(pixels):
                                raise RuntimeError('Incomplete console restore write')
                        backup.unlink()
                        state.unlink()
                        print('Original text-console cells, attributes and cursor restored.')
                        return
                    if len(pixels) != FRAME_BYTES:
                        raise RuntimeError('Invalid console backup length')
                    try:
                        screen[:] = pixels
                    finally:
                        fcntl.ioctl(tty, 0x4B3A, saved['mode'])
                    backup.unlink()
                    state.unlink()
                    print('Saved framebuffer and text-console mode restored; test backup removed.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('show', 'console', 'restore', 'info'))
    args = parser.parse_args()
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, interrupted)
    try:
        run(args.action)
    except (OSError, RuntimeError, ValueError, KeyError) as error:
        parser.exit(1, f'dt510-hdmi-test: {error}\n')


if __name__ == '__main__':
    main()
