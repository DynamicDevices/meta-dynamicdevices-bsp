From: Alex Lennon <ajlennon@dynamicdevices.co.uk>
Subject: [PATCH] video: route Jaguar Screen DSIM to HX8279-D panel

Select the production ST1010/HX8279-D panel and route the first DSIM output
away from the EVK ADV7535 HDMI bridge.

Signed-off-by: Alex Lennon <ajlennon@dynamicdevices.co.uk>

---
diff --git a/arch/arm/dts/imx8mm-evk.dtsi b/arch/arm/dts/imx8mm-evk.dtsi
index 20027497..9b291dff 100644
--- a/arch/arm/dts/imx8mm-evk.dtsi
+++ b/arch/arm/dts/imx8mm-evk.dtsi
@@ -138,25 +138,24 @@
 	};
 
 	rm67199_panel {
-		compatible = "raydium,rm67199";
+		compatible = "santek,st1010b3cyol", "himax,hx8279d";
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_mipi_dsi_en>;
-		reset-gpio = <&gpio1 8 GPIO_ACTIVE_LOW>;
+		enable-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
+		backlight-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
 		dsi-lanes = <4>;
-		video-mode = <2>;	/* 0: burst mode
-					 * 1: non-burst mode with sync event
-					 * 2: non-burst mode with sync pulse
-					 */
-		panel-width-mm = <68>;
-		panel-height-mm = <121>;
+		video-mode = <2>;
+		panel-width-mm = <229>;
+		panel-height-mm = <143>;
+		rotation = <90>;
 		status = "okay";
 
-		port {
-			rm67191_from_dsim: endpoint {
-				remote-endpoint = <&dsim_to_rm67191>;
-			};
+	port {
+		rm67191_from_dsim: endpoint {
+			remote-endpoint = <&dsim_to_adv7535>;
 		};
 	};
+	};
 };
 
 &A53_0 {
@@ -346,7 +345,7 @@
 		reg = <0x3d>;
 		adi,addr-cec = <0x3c>;
 		adi,dsi-lanes = <4>;
-		status = "okay";
+		status = "disabled";
 
 		port {
 			adv7535_from_dsim: endpoint {
@@ -514,15 +513,10 @@
 
 	port@1 {
 		dsim_to_adv7535: endpoint {
-			remote-endpoint = <&adv7535_from_dsim>;
-		};
-	};
-
-	port@2 {
-		dsim_to_rm67191: endpoint {
 			remote-endpoint = <&rm67191_from_dsim>;
 		};
 	};
+
 };
 
 &iomuxc {
@@ -732,7 +726,8 @@
 
 	pinctrl_mipi_dsi_en: mipidsiengrp {
 		fsl,pins = <
-			MX8MM_IOMUXC_GPIO1_IO08_GPIO1_IO8		0x19
+			MX8MM_IOMUXC_GPIO1_IO12_GPIO1_IO12	0x116
+			MX8MM_IOMUXC_GPIO1_IO01_GPIO1_IO1	0x116
 		>;
 	};
 };
diff --git a/drivers/video/Kconfig b/drivers/video/Kconfig
index 57d78840..2f5de9b8 100644
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -514,6 +514,17 @@ config VIDEO_LCD_HIMAX_HX8394
 	Say Y here if you want to enable support for Himax HX8394
 	dsi 4dl panel.
 
+config VIDEO_LCD_HIMAX_HX8279D
+	bool "Himax HX8279-D / Santek ST1010 DSI panel support"
+	depends on VIDEO
+	select VIDEO_MIPI_DSI
+	default n
+	help
+	  Enable the four-lane 1200x1920 Santek ST1010B3CYOL panel used by
+	  the i.MX8MM Jaguar Screen.
+	  The module contains two HX8279-D controller instances and requires
+	  its vendor initialization sequence before video scanout begins.
+
 config VIDEO_LCD_ORISETECH_OTM8009A
 	bool "OTM8009A DSI LCD panel support"
 	select VIDEO_MIPI_DSI
diff --git a/drivers/video/Makefile b/drivers/video/Makefile
index 2c662e5f..99eb0ab1 100644
--- a/drivers/video/Makefile
+++ b/drivers/video/Makefile
@@ -56,6 +56,7 @@ obj-$(CONFIG_VIDEO_EFI) += efi.o
 obj-$(CONFIG_VIDEO_IVYBRIDGE_IGD) += ivybridge_igd.o
 obj-$(CONFIG_VIDEO_LCD_ANX9804) += anx9804.o
 obj-$(CONFIG_VIDEO_LCD_ENDEAVORU) += endeavoru-panel.o
+obj-$(CONFIG_VIDEO_LCD_HIMAX_HX8279D) += himax-hx8279d.o
 obj-$(CONFIG_VIDEO_LCD_HIMAX_HX8394) += himax-hx8394.o
 obj-$(CONFIG_VIDEO_LCD_HITACHI_TX18D42VM) += hitachi_tx18d42vm_lcd.o
 obj-$(CONFIG_VIDEO_LCD_ORISETECH_OTM8009A) += orisetech_otm8009a.o

-- 
2.43.0

