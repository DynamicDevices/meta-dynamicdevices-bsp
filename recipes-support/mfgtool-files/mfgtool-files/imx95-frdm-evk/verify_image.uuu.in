uuu_version 1.4.149

# Optional, standalone read-back verification. This is deliberately separate
# from full_image.uuu so normal production programming does not pay the cost.
SDP: boot -f imx-boot-mfgtool
SDPS: boot -f imx-boot-mfgtool

SDPU: delay 1000
SDPU: write -f imx-boot-mfgtool -offset 0x57c00
SDPU: jump

SDPV: delay 1000
SDPV: write -f imx-boot-mfgtool -skipspl
SDPV: jump

FB: delay 5000
FB: ucmd setenv fastboot_dev mmc
FB: ucmd setenv emmc_dev 0
FB: ucmd setenv mmcdev 0
FB: ucmd setenv loadaddr 0x92800000
FB: ucmd mmc dev ${mmcdev} 0
# Verify from the WIC boot partition at 4 MiB through the end of the image.
# The first 4 MiB is excluded because the production u-boot.itb is installed
# there after the WIC and intentionally differs from the WIC's empty gap.
FB[-t 1800000]: crc -f ../@@MFGTOOL_FLASH_IMAGE@@-@@MACHINE@@@@IMAGE_NAME_SUFFIX@@.wic.gz/* -blksz 512 -each 0x4000000 -skip 0x400000 -seek 0x400000
FB: done
