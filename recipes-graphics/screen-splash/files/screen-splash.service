[Unit]
Description=Active-Edge early display splash
DefaultDependencies=no
After=local-fs.target systemd-udev-trigger.service
Before=graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/screen-splash /usr/share/screen-splash/active-edge-splash.png @SCREEN_SPLASH_WAIT_MS@
TimeoutStartSec=20
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=basic.target
